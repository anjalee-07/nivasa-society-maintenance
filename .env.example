# Comma-separated emails that should receive the admin role.
# This list is authoritative: an email removed from it is demoted on its next
# request, so set it before deploying or the society will have no administrators.
ADMIN_EMAILS=admin@example.com

# Resend integration. Both values are required together to deliver email.
# Without them, notifications stay queued in the in-app delivery center with
# their retry budget intact and can be sent later from "Send all queued".
#
# EMAIL_FROM has no default on purpose: Resend rejects every sender it has not
# verified, so a guessed address fails silently for the whole society. Use an
# address on a domain verified in your Resend dashboard.
RESEND_API_KEY=
EMAIL_FROM=Nivasa <notifications@your-verified-domain.com>

# Local preview fixtures. The local Wrangler config sets this for you; hosted
# environments should leave it unset unless you deliberately want demo data.
# SEED_DEMO_DATA=true

# Local demo only. Resend's shared test sender (onboarding@resend.dev) delivers
# only to the address that owns the Resend account, so set this to that address
# to watch a real email arrive locally. Leave unset in hosted environments.
# DEMO_RESIDENT_EMAIL=you@example.com

# Set to 1 to keep the outbox working but never call the email provider.
# Automated tests set this themselves; useful for staging environments too.
# EMAIL_DELIVERY_DISABLED=1

# Optional review access. When set, a signed-in visitor can claim the admin role
# once by opening /?admin=<code>. Leave unset to remove the route entirely.
# Use a long random value and clear it when review is finished.
# ADMIN_INVITE_CODE=

# Set to 1 ONLY when the hosting layer authenticates visitors and strips the
# oai-authenticated-user-* headers from inbound requests. Anywhere else these
# headers are forgeable and this must stay unset, so the app uses its own
# email and password sign-in instead.
# TRUST_PLATFORM_IDENTITY=1
